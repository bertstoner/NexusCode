{
  "name": "@workspace/cli",
  "version": "1.0.0",
  "description": "Claude Code-style AI coding assistant CLI with Ollama and Cerebras support",
  "private": true,
  "bin": {
    "code-ai": "./dist/index.js"
  },
  "scripts": {
    "dev": "node --enable-source-maps --import=tsx/esm src/index.ts",
    "build": "node --input-type=module < build.mjs",
    "start": "node --enable-source-maps ./dist/index.js",
    "setup": "node --enable-source-maps --import=tsx/esm src/index.ts --setup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "cli-spinners": "^2.9.2",
    "diff": "^7.0.0",
    "fast-glob": "^3.3.3",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "node-fetch": "^3.3.2",
    "ora": "^8.2.0",
    "readline": "^1.3.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "tsx": "catalog:"
  }
}
