# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=nexuscode
POSTGRES_USER=nexus
POSTGRES_PASSWORD=changeme

# ── API server ───────────────────────────────────────────────────────────────
NODE_ENV=production
API_PORT=8080

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_PORT=8081

# ── Ollama (local LLM for code-ai CLI) ──────────────────────────────────────
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.1

# ── Open WebUI ───────────────────────────────────────────────────────────────
WEBUI_PORT=3000

# ── Cerebras AI — used by both the nexus CLI and Open WebUI ─────────────────
# Get a key at https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# ── Tavily web search — used by both the nexus CLI and Open WebUI ────────────
# Get a key at https://app.tavily.com
TAVILY_API_KEY=
