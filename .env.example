# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=nexuscode
POSTGRES_USER=nexus
POSTGRES_PASSWORD=changeme

# ── API server ───────────────────────────────────────────────────────────────
NODE_ENV=production
API_PORT=8080

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_PORT=8081

# ── Ollama (local LLM for code-ai CLI) ──────────────────────────────────────
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.1

# ── Open WebUI ───────────────────────────────────────────────────────────────
WEBUI_PORT=3000

# ── code-ai: Cerebras AI (alternative to Ollama) ────────────────────────────
CEREBRAS_API_KEY=

# ── code-ai: Tavily web search (optional) ───────────────────────────────────
TAVILY_API_KEY=
